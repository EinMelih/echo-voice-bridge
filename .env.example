# Required
OPENAI_API_KEY=
# The Echo's node name as its beacons report it, e.g. echo-dot-3-abc123 (shown on its settings page)
EVB_ECHO_NODE=

# Home Assistant: required for joining the Echo network, optional afterwards
EVB_HA_URL=http://homeassistant.local:8123
EVB_HA_TOKEN=
# While this player is playing, the wake word stays with the Echo so "<wake word>, stop" keeps working
EVB_HA_MEDIA_PLAYER=
# Optional: a light to switch on during conversations (the Echo's "Light ring" entity)
EVB_HA_LIGHT=
EVB_HA_LIGHT_EFFECT=Rainbow

# Voice
EVB_MODEL=gpt-realtime-2.1
EVB_VOICE=marin
# ISO-639-1 language for transcription, e.g. de
EVB_LANGUAGE=
EVB_INSTRUCTIONS=

# Hang up after this many seconds without speech
EVB_IDLE_S=120
# Directory for a JSONL record of conversations; empty keeps none
EVB_TRANSCRIPT_DIR=
